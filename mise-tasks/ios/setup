#!/usr/bin/env bash
#MISE description="Check the Mac has what the iOS app needs: Xcode, XcodeGen, an iOS simulator runtime"
set -euo pipefail
[ "$(uname -s)" = Darwin ] || { echo "iOS needs the Mac: mise run ios:remote ios:setup" >&2; exit 2; }
xcodebuild -version | head -1
command -v xcodegen >/dev/null || brew install xcodegen
xcodegen --version
xcrun simctl list runtimes | grep -q "iOS" || { echo "No iOS simulator runtime: Xcode > Settings > Components" >&2; exit 1; }
echo "ready"
