#!/usr/bin/env bash
#MISE description="Lint Kotlin (ktlint), Swift (SwiftFormat) and the GitHub workflows (actionlint); FIX=1 fixes what they can"
set -euo pipefail
kotlin=("android/**/*.kt" "android/**/*.kts" "!android/**/build/**")
swift=(./ios maestro/gestures/ios)
if [ -n "${FIX:-}" ]; then
  ktlint -F "${kotlin[@]}"
  swiftformat --quiet "${swift[@]}"
else
  ktlint "${kotlin[@]}"
  swiftformat --lint --quiet "${swift[@]}"
fi
actionlint
echo "lint ok"
