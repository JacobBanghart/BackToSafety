#!/usr/bin/env bash
#MISE description="Rust port: run Maestro flows (maestro/flows, retargeted at the Rust app) on ANDROID_SERIAL only. Args: flow names (default all)"
set -euo pipefail
: "${ANDROID_SERIAL:?set ANDROID_SERIAL to the lane emulator (rust/scripts/emulator.sh up PORT)}"
out="${OUT:-/tmp/nijii-flows-rust/$ANDROID_SERIAL}"
rm -rf "$out" && mkdir -p "$out"
adb install -r "$(mise run -q rust:build)" >/dev/null
tree="$(rust/scripts/retarget.sh "$out/maestro")"
names=("$@")
[ ${#names[@]} -gt 0 ] || for f in "$tree"/flows/*.yaml; do names+=("$(basename "$f" .yaml)"); done
status=0
for name in "${names[@]}"; do
  if maestro --device "$ANDROID_SERIAL" test --no-ansi "$tree/flows/$name.yaml" --test-output-dir "$out/$name" >"$out/$name.log" 2>&1; then
    echo "ok   $name"
  else
    echo "FAIL $name ($out/$name.log)"; grep -E 'FAILED|Element not found|Assertion' "$out/$name.log" | head -3 | sed 's/^/     /'
    status=1
  fi
done
exit $status
