#!/usr/bin/env bash
#MISE description="Rust port: build the Android APK (TARGET=aarch64-linux-android for a phone). Queued (one build at a time across worktrees). Prints the APK path."
#MISE depends=["rust:sdk"]
set -euo pipefail
export ANDROID_NDK_HOME="$ANDROID_HOME/ndk/29.0.14206865"
profile=debug; [ -z "${RELEASE:-}" ] || profile=release
root="$PWD"
out="$root/rust/out/nijii-$profile.apk"
mkdir -p "$root/rust/out"
# Every worktree shares CARGO_TARGET_DIR (mise.toml), so the build, copying its APK out and
# stopping Gradle all happen under heavy.sh's lock; another worktree's build would
# overwrite the APK.
rust/scripts/heavy.sh bash -c '
  set -euo pipefail
  cd rust/app
  dx build --platform android --target "${TARGET:-x86_64-linux-android}" ${RELEASE:+--release} >&2
  apk="$(find "$CARGO_TARGET_DIR/dx/nijii/'"$profile"'/android" -name "*.apk" -path "*outputs/apk*" | head -1)"
  cp "$apk" "'"$out"'"
  # dx bundles with Gradle; its daemon (2 GB heap) would otherwise linger for hours.
  gradlew="$CARGO_TARGET_DIR/dx/nijii/'"$profile"'/android/app/gradlew"
  [ -x "$gradlew" ] && "$gradlew" --stop -q >/dev/null 2>&1 || true
'
echo "$out"
