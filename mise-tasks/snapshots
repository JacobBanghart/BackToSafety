#!/usr/bin/env bash
#MISE description="Android snapshot tests: every main screen rendered on the JVM vs src/test/snapshots (RECORD=1 re-records)"
set -euo pipefail
cd android
if [ -n "${RECORD:-}" ]; then
  ../scripts/heavy.sh ./gradlew --no-daemon :app:testDebugUnitTest -Precord --console=plain -q
  echo "recorded android/app/src/test/snapshots"
else
  ../scripts/heavy.sh ./gradlew --no-daemon :app:testDebugUnitTest --console=plain -q || {
    echo "differences: android/app/build/outputs/roborazzi (RECORD=1 if deliberate)" >&2
    exit 1
  }
  echo "snapshots match"
fi
