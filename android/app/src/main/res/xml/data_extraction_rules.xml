<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher; see backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="SecureStore" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="SecureStore" />
    </device-transfer>
</data-extraction-rules>
