{
  "name": "back-to-safety",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:e2e": "CI=1 expo start --web --port 19006",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "prebuild:clean": "rm -rf android ios && expo prebuild",
    "build:apk": "cd android && ANDROID_HOME=~/Android/Sdk ./gradlew assembleRelease && cd .. && mkdir -p build && cp android/app/build/outputs/apk/release/app-release.apk build/BackToSafety.apk && echo 'APK built: build/BackToSafety.apk'",
    "build:aab": "cd android && ANDROID_HOME=~/Android/Sdk ./gradlew bundleRelease && cd .. && mkdir -p build && cp android/app/build/outputs/bundle/release/app-release.aab build/BackToSafety.aab && echo 'AAB built: build/BackToSafety.aab'",
    "build:android": "npm run build:apk && npm run build:aab",
    "clean": "rm -rf android ios build .expo node_modules/.cache",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@posthog/react-native-plugin": "^2.12.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.27",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.3",
    "expo-contacts": "~57.0.6",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sms": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.3.6",
    "posthog-react-native": "^4.55.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.9",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.61.1",
    "@types/react": "~19.2.18",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "~6.0.3",
    "vite-plus": "^1.1.0",
    "vitest": "^5.0.3"
  },
  "private": true
}
