{
  "source": "kmp/shared EmergencyAlerts.kt",
  "description": "Countdown alerts while the emergency screen isn't showing: when each alert is due (the moment countdownAlerts fires it: the warning one second past the 5-minute mark, so 601s in), what to schedule as notifications on leaving the screen, what to catch up on returning, and the properties of the metrics around them. Times are ISO timestamps; expected values were worked out by hand from the countdown rules, not generated.",
  "functions": {
    "alertDueAt": [
      {
        "args": [
          "warning",
          "2026-10-06T15:00:00.000Z"
        ],
        "expected": "2026-10-06T15:10:01Z"
      },
      {
        "args": [
          "expired",
          "2026-10-06T15:00:00.000Z"
        ],
        "expected": "2026-10-06T15:15:00Z"
      },
      {
        "args": [
          "warning",
          "2026-10-06T23:52:30.250Z"
        ],
        "expected": "2026-10-07T00:02:31.250Z"
      }
    ],
    "alertsToSchedule": [
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:00:00.000Z"
        ],
        "expected": [
          {
            "alert": "warning",
            "fireAt": "2026-10-06T15:10:01Z"
          },
          {
            "alert": "expired",
            "fireAt": "2026-10-06T15:15:00Z"
          }
        ]
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:10:00.999Z"
        ],
        "expected": [
          {
            "alert": "warning",
            "fireAt": "2026-10-06T15:10:01Z"
          },
          {
            "alert": "expired",
            "fireAt": "2026-10-06T15:15:00Z"
          }
        ]
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:10:01.000Z"
        ],
        "expected": [
          {
            "alert": "expired",
            "fireAt": "2026-10-06T15:15:00Z"
          }
        ]
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:15:00.000Z"
        ],
        "expected": []
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T16:00:00.000Z"
        ],
        "expected": []
      }
    ],
    "catchUpAlert": [
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:05:00.000Z",
          "2026-10-06T15:09:00.000Z"
        ],
        "expected": null
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:05:00.000Z",
          "2026-10-06T15:10:01.000Z"
        ],
        "expected": "warning"
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:05:00.000Z",
          "2026-10-06T15:20:00.000Z"
        ],
        "expected": "expired"
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:10:01.000Z",
          "2026-10-06T15:12:00.000Z"
        ],
        "expected": null
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:10:30.000Z",
          "2026-10-06T15:16:00.000Z"
        ],
        "expected": "expired"
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:14:59.999Z",
          "2026-10-06T15:15:00.000Z"
        ],
        "expected": "expired"
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:15:00.000Z",
          "2026-10-06T15:30:00.000Z"
        ],
        "expected": null
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:16:00.000Z",
          "2026-10-06T15:20:00.000Z"
        ],
        "expected": null
      }
    ],
    "countdownAlertProperties": [
      {
        "args": [
          "warning",
          "in_app"
        ],
        "expected": {
          "kind": "warning",
          "delivery": "in_app"
        }
      },
      {
        "args": [
          "expired",
          "catch_up"
        ],
        "expected": {
          "kind": "expired",
          "delivery": "catch_up"
        }
      }
    ],
    "emergencyEndedProperties": [
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T15:07:30.900Z",
          3
        ],
        "expected": {
          "checked_count": 3,
          "duration_s": 450
        }
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T17:00:00.000Z",
          0
        ],
        "expected": {
          "checked_count": 0,
          "duration_s": 7200
        }
      },
      {
        "args": [
          "2026-10-06T15:00:00.000Z",
          "2026-10-06T14:59:00.000Z",
          1
        ],
        "expected": {
          "checked_count": 1,
          "duration_s": 0
        }
      }
    ],
    "readinessProperties": [
      {
        "args": [
          null,
          0,
          0,
          0
        ],
        "expected": {
          "has_profile": false,
          "has_photo": false,
          "has_medical": false,
          "profile_fields_filled": 0,
          "contacts_count": 0,
          "alert_contacts_count": 0,
          "places_count": 0
        }
      },
      {
        "args": [
          {
            "name": "Margaret Smith",
            "nickname": "  ",
            "photoUri": "file:///photos/p.jpg",
            "height": "5' 4\"",
            "medicalConditions": "Dementia",
            "dominantHand": "unknown",
            "safeWord": ""
          },
          3,
          2,
          1
        ],
        "expected": {
          "has_profile": true,
          "has_photo": true,
          "has_medical": true,
          "profile_fields_filled": 3,
          "contacts_count": 3,
          "alert_contacts_count": 2,
          "places_count": 1
        }
      },
      {
        "args": [
          {
            "name": "Margaret Smith",
            "dominantHand": "left",
            "medicalConditions": " "
          },
          1,
          0,
          0
        ],
        "expected": {
          "has_profile": true,
          "has_photo": false,
          "has_medical": false,
          "profile_fields_filled": 1,
          "contacts_count": 1,
          "alert_contacts_count": 0,
          "places_count": 0
        }
      }
    ],
    "smsResultProperties": [
      {
        "args": [
          "sent",
          2
        ],
        "expected": {
          "result": "sent",
          "recipient_count": 2
        }
      },
      {
        "args": [
          "handed_off",
          1
        ],
        "expected": {
          "result": "handed_off",
          "recipient_count": 1
        }
      },
      {
        "args": [
          "unavailable",
          0
        ],
        "expected": {
          "result": "unavailable",
          "recipient_count": 0
        }
      }
    ],
    "dialFailedProperties": [
      {
        "args": [
          "emergency",
          "emergency"
        ],
        "expected": {
          "target": "emergency",
          "screen": "emergency"
        }
      },
      {
        "args": [
          "medicalert",
          "readout"
        ],
        "expected": {
          "target": "medicalert",
          "screen": "readout"
        }
      }
    ],
    "emergencyResumedProperties": [
      {
        "args": [
          "2026-10-06T15:05:00.000Z",
          "2026-10-06T15:20:30.500Z",
          "expired"
        ],
        "expected": {
          "away_s": 930,
          "catch_up": "expired"
        }
      },
      {
        "args": [
          "2026-10-06T15:05:00.000Z",
          "2026-10-06T15:05:42.000Z",
          null
        ],
        "expected": {
          "away_s": 42,
          "catch_up": null
        }
      }
    ],
    "saveFailedProperties": [
      {
        "args": [
          "contacts",
          "save",
          "SQLiteException"
        ],
        "expected": {
          "screen": "contacts",
          "action": "save",
          "error": "SQLiteException"
        }
      },
      {
        "args": [
          "settings",
          "delete_account",
          null
        ],
        "expected": {
          "screen": "settings",
          "action": "delete_account",
          "error": "unknown"
        }
      }
    ]
  }
}
