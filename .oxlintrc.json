{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/set-state-in-effect": "warn",
    "react/purity": "warn"
  },
  "env": {
    "builtin": true
  }
}
